# syntax=docker/dockerfile:1
# Foxsight License Client Service Dockerfile
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements file
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Expose port

# Health check
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

# Run the application

# ============================================================
# SOURCE PROTECTION — PyArmor 9 BCC
# Compiles Python functions to native C extensions.
# Requires --pyarmor flag on build-deploy-images.sh.
# Skipped silently if no license secret is provided.
# ============================================================
RUN --mount=type=secret,id=pyarmor_license,target=/tmp/pyarmor_license.zip \
    if [ -f /tmp/pyarmor_license.zip ]; then \
        pip install pyarmor --no-cache-dir && \
        pyarmor reg /tmp/pyarmor_license.zip && \
        cd /app && \
        pyarmor gen --enable-bcc --recursive --output /tmp/pyarmor-dist . && \
        cp -rT /tmp/pyarmor-dist /app && \
        rm -rf /tmp/pyarmor-dist && \
        pip uninstall -y pyarmor && \
        echo "PyArmor BCC obfuscation complete."; \
    else \
        echo "PyArmor license not provided — skipping source obfuscation."; \
    fi


# ============================================================
# DEPLOYMENT HARDENING — non-root user, no shells, no tools
# ============================================================

# Create non-root user
RUN addgroup --gid 1001 foxsight && \
    adduser --uid 1001 --gid 1001 --disabled-password --gecos "" foxsight

# Own app directory
RUN chown -R foxsight:foxsight /app

# Remove shells, package managers, and debug tools
RUN rm -f /bin/sh /bin/bash /bin/dash /usr/bin/sh /usr/bin/bash /usr/bin/dash \
          /usr/bin/apt /usr/bin/apt-get /usr/bin/dpkg \
          /usr/bin/pip /usr/bin/pip3 /usr/local/bin/pip /usr/local/bin/pip3 \
          /usr/bin/curl /usr/bin/wget && \
    cp /bin/true /bin/sh 2>/dev/null || true

USER foxsight

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
